{
  "name": "dsh-composer-predictions",
  "version": "1.2.8",
  "description": "Tab autocomplete for the DeepSeek Harness desktop and web composer: next-message ghost text, inline draft completion and keyboard candidate cycling",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "composer",
    "autocomplete",
    "tab-completion"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "catalog": {
      "summary": {
        "en": "Tab autocomplete for the DeepSeek Harness composer: next-message ghost text, inline draft completion and keyboard candidate cycling.",
        "zh": "DeepSeek Harness \u8f93\u5165\u6846\u7684 Tab \u81ea\u52a8\u8865\u5168\uff1a\u56de\u590d\u540e\u7684\u4e0b\u4e00\u53e5\u5efa\u8bae\u3001\u8f93\u5165\u505c\u987f\u65f6\u7684\u8349\u7a3f\u7eed\u5199\uff0c\u4ee5\u53ca\u952e\u76d8\u5207\u6362\u5019\u9009\u3002"
      },
      "category": "ui"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stijnus/dsh-composer-predictions.git"
  },
  "homepage": "https://github.com/Stijnus/dsh-composer-predictions#readme",
  "bugs": {
    "url": "https://github.com/Stijnus/dsh-composer-predictions/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  }
}
