{
  "name": "dsh-composer-predictions",
  "version": "1.2.6",
  "description": "Tab autocomplete for the DeepSeek Harness desktop and web composer: next-message ghost text, inline draft completion and keyboard candidate cycling",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "composer",
    "autocomplete",
    "tab-completion"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "catalog": {
      "summary": {
        "en": "Tab autocomplete for the DeepSeek Harness composer: next-message ghost text, inline draft completion and keyboard candidate cycling.",
        "zh": "DeepSeek Harness 输入框的 Tab 自动补全：回复后的下一句建议、输入停顿时的草稿续写，以及键盘切换候选。"
      },
      "category": "ui"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stijnus/dsh-composer-predictions.git"
  },
  "homepage": "https://github.com/Stijnus/dsh-composer-predictions#readme",
  "bugs": {
    "url": "https://github.com/Stijnus/dsh-composer-predictions/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  }
}
